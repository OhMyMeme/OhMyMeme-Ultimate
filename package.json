{
  "name": "ohmymeme-ultimate",
  "version": "0.2.0-beta",
  "private": true,
  "description": "OhMyMeme-Ultimate monorepo (Rust server + Desktop Tauri; Nuxt Web frontend paused)",
  "workspaces": [
    "rust-server",
    "tauri-app",
    "nuxt-app"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=!ohmymeme-web",
    "dev:server": "turbo run dev --filter=ohmymeme-server",
    "dev:server:release": "turbo run dev:release --filter=ohmymeme-server",
    "dev:desktop": "turbo run dev --filter=ohmymeme-desktop",
    "dev:desktop:web": "turbo run dev:web --filter=ohmymeme-desktop",
    "build": "turbo run build --filter=!ohmymeme-web",
    "build:server": "turbo run build --filter=ohmymeme-server",
    "build:desktop": "turbo run build --filter=ohmymeme-desktop",
    "reset:dev": "node rust-server/scripts/reset-dev.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "vue-demi@0.14.10": true,
    "unrs-resolver@1.12.2": true,
    "sharp@0.33.5": true
  }
}
