{
  "name": "ohmymeme-ultimate",
  "version": "0.1.0",
  "private": true,
  "description": "OhMyMeme-Ultimate monorepo (Web Nuxt + Desktop Tauri)",
  "workspaces": [
    "nuxt-app",
    "tarui-app"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=ohmymeme-web",
    "dev:desktop": "turbo run dev --filter=ohmymeme-desktop",
    "dev:desktop:web": "turbo run dev:web --filter=ohmymeme-desktop",
    "build:web": "turbo run build --filter=ohmymeme-web",
    "build:desktop": "turbo run build --filter=ohmymeme-desktop",
    "preview": "turbo run preview --filter=ohmymeme-web",
    "generate": "turbo run generate --filter=ohmymeme-web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "vue-demi@0.14.10": true,
    "unrs-resolver@1.12.2": true
  }
}
