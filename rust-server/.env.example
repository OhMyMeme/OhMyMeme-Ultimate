# MongoDB 连接串（必填，本地或 Atlas 云数据库）
MONGO_URI=mongodb://localhost:27017/ohmymeme

# 登录访问密钥（必填，登录时输入该字符串）
# 生成 256 位随机字符串：node -e "console.log(require('crypto').randomBytes(128).toString('hex'))"
ACCESS_TOKEN=

# 监听端口（可选，默认 3000）
# PORT=3000

# 监听地址（可选，默认 0.0.0.0，局域网可访问）
# HOST=0.0.0.0

# API 跨域白名单（可选，逗号分隔，默认同源 + 桌面端来源）
ALLOWED_ORIGINS=http://localhost:1420

# 表情文件存储目录（可选，默认 .data/uploads/memes）
# STORAGE_LOCAL_DIR=.data/uploads/memes

# Web 页面访问开关（可选，默认 false 即禁止 Web 页面访问，仅保留 API / WS 供桌面端使用）
# WEB_ENABLED=false

# 日志级别（可选，error / warn / info / debug，默认 info；debug 输出鉴权失败原因、实时广播等细节）
# RUST_LOG=info
