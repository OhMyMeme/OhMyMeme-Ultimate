{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OhMyMeme",
  "version": "0.4.0",
  "identifier": "cn.lorien.ohmymeme",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OhMyMeme Desktop",
        "width": 960,
        "height": 600,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxREYxM0JBRDQ5OEI5NTMKUldSVHVaalV1aFBmNGYya0UvcG4xcWE5MkZDOTVxbXJ6NW5DMFNHaU5BNkI4cW1DSGEvN1ZLQnMK",
      "endpoints": ["https://github.com/OhMyMeme/OhMyMeme-Ultimate/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "basicUi"
      },
      "active": true
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
