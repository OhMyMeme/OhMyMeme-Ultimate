# MongoDB 连接串（必填，本地或 Atlas 云数据库）
NUXT_MONGOOSE_URI=mongodb://localhost:27017/ohmymeme

# 登录访问密钥（必填，登录时输入该字符串）
# 生成 256 位随机字符串：node -e "console.log(require('crypto').randomBytes(128).toString('hex'))"
NUXT_ACCESS_TOKEN=

# 会话签名密钥（必填，至少 32 字符，用于加密会话 Cookie）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=

# 监听端口（可选，默认 3000）
# PORT=3000

# 监听地址（可选，默认 0.0.0.0，局域网可访问）
# HOST=0.0.0.0
